_warn_valkey_alias() {
  local unit=/etc/systemd/system/redis.service
  if [[ -L $unit && ! -e $unit ]] &&
     [[ $(readlink "$unit") == /usr/lib/systemd/system/valkey.service ]]; then
    echo ""
    echo "A stale Valkey alias hides redis.service."
    echo "Run: systemctl disable valkey.service"
    echo "Then: systemctl daemon-reload"
    echo ""
  fi
}

# pacman keeps a modified redis.conf and writes the packaged one next to it.
_note_bundled_modules() {
  local conf=/etc/redis/redis.conf
  if [[ -f $conf.pacnew ]] &&
     grep -Eq '^[[:space:]]*loadmodule[[:space:]]' "$conf.pacnew" &&
     ! grep -Eq '^[[:space:]]*loadmodule[[:space:]]' "$conf"; then
    echo ""
    echo "The existing $conf was kept and does not load the bundled modules."
    echo "To load them, merge the loadmodule directives from $conf.pacnew"
    echo ""
  fi
}

post_install() {
  _warn_valkey_alias
  _note_bundled_modules
}

post_upgrade() {
  _warn_valkey_alias
  _note_bundled_modules
}
